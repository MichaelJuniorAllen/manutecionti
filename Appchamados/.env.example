# Backend
PORT=4000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=8h
SUPPORT_EMAIL=Suporte@upacentral.co.uk
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://seu-site.netlify.app,https://*.netlify.app,https://seu-site.pages.dev,https://*.pages.dev,https://*.trycloudflare.com
DATABASE_URL=
PGSSL=true

# SMTP (envio real de codigo de confirmacao de e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Suporte@upacentral.co.uk

# API de e-mail (Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Suporte <Suporte@upacentral.co.uk>

# Ative apenas em desenvolvimento para registrar o codigo no log sem enviar e-mail
EMAIL_FALLBACK_ENABLED=false

# API de e-mail (SendGrid)
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=Suporte@upacentral.co.uk

# SMS (envio real de codigo de confirmacao de telefone)
SMS_PROVIDER=twilio
SMS_DEFAULT_COUNTRY_CODE=55
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+5511999999999

# Frontend (necessario no build de producao)
VITE_API_URL=http://localhost:4000/api
VITE_SERVER_URL=http://localhost:4000
